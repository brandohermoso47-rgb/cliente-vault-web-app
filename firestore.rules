rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'usuario');
    }
    function isAdmin() { return signedIn() && role() == 'admin'; }
    // Personal que publica contenido: admin, instructor o estudio (roles que asigna un admin).
    function isStaff() { return signedIn() && (role() == 'admin' || role() == 'instructor' || role() == 'estudio'); }
    function roleUnchanged() {
      return request.resource.data.get('role', 'usuario') == resource.data.get('role', 'usuario');
    }
    function shortText(field, max) { return request.resource.data.get(field, '').size() <= max; }
    // Campos de facturación/dinero: solo los escribe el Admin SDK (webhook); ni el dueño ni un admin desde el cliente.
    function billingUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['billingStatus', 'subscriptionTier', 'subscribedInstructorIds',
                 'instructorSubscriptionStatus', 'isFeaturedInstructor', 'featuredPlan', 'featuredExpiry',
                 'stripeCustomerId', 'stripeAccountId', 'isConnectVerified']);
    }
    function only(fields) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields); }

    // ── Perfiles ─────────────────────────────────────────────────────────
    match /users/{userId} {
      // Los perfiles (nombre, usuario, país, bio, foto, rol) los ven usuarios con sesión. El correo NO se guarda aquí.
      allow read: if signedIn();
      // Al crearse, todo perfil nace como 'usuario' y solo con los campos conocidos y de tamaño razonable.
      allow create: if isOwner(userId)
        && request.resource.data.get('role', 'usuario') == 'usuario'
        && request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'photoPath', 'handle', 'country', 'countryCode', 'bio', 'accountType', 'role', 'createdAt', 'updatedAt', 'email'])
        && shortText('bio', 280) && shortText('displayName', 80) && shortText('handle', 20);
      // El dueño edita su perfil pero no su rol ni campos de facturación/dinero; solo el Admin SDK (webhook) los modifica.
      // Se revisan solo los campos que de verdad cambian (diff), no todo el documento: así un perfil
      // viejo con algún campo heredado no bloquea futuras ediciones (p. ej. subir la foto).
      allow update: if (isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['role', 'billingStatus', 'subscriptionTier', 'subscribedInstructorIds',
                        'instructorSubscriptionStatus', 'isFeaturedInstructor', 'featuredPlan', 'featuredExpiry',
                        'stripeCustomerId', 'stripeAccountId', 'isConnectVerified'])
          && only(['displayName', 'photoURL', 'photoPath', 'handle', 'country', 'countryCode', 'bio', 'accountType', 'role', 'createdAt', 'updatedAt', 'email'])
          && shortText('bio', 280) && shortText('displayName', 80) && shortText('handle', 20))
        || (isAdmin() && billingUntouched());
      allow delete: if isAdmin();

      // Datos privados del usuario (galería, playlists, favoritos, práctica…): solo el dueño.
      match /{sub}/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ── Contenido de instructores/estudios/admin: lo lee cualquiera con sesión ──
    match /{content}/{docId} {
      allow read: if signedIn()
        && content in ['teachers', 'lives', 'lessons', 'announcements', 'presentations', 'ebooks', 'events',
                       'instructor_playlists', 'instructor_tracks', 'instructor_drive_tracks'];
      // Publica el personal, pero solo edita/borra lo suyo (ownerId); el admin edita todo.
      allow create: if content in ['teachers', 'lives', 'lessons', 'announcements', 'presentations', 'ebooks', 'events',
                                   'instructor_playlists', 'instructor_tracks', 'instructor_drive_tracks']
        && (isAdmin() || (isStaff() && request.resource.data.get('ownerId', '') == request.auth.uid));
      allow update, delete: if content in ['teachers', 'lives', 'lessons', 'announcements', 'presentations', 'ebooks', 'events',
                                          'instructor_playlists', 'instructor_tracks', 'instructor_drive_tracks']
        && (isAdmin() || (isStaff() && resource.data.get('ownerId', '') == request.auth.uid));
    }

    // ── Reels: el feed de la comunidad — cualquier persona con sesión publica el suyo ──
    match /reels/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid
        && shortText('caption', 300)
        && request.resource.data.keys().hasOnly(['ownerId', 'user', 'caption', 'music', 'mediaUrl', 'mediaType', 'c1', 'c2', 'createdAt']);
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId && only(['caption']) && shortText('caption', 300);
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    // ── Modo Practice / Battle Training: videollamada 1 a 1 (señalización WebRTC).
    //    { callerId, calleeId, mode: 'practice'|'battle', offer, answer, status, round, createdAt } ──
    match /battle_calls/{id} {
      allow read: if signedIn() && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.callerId == request.auth.uid
        && request.resource.data.calleeId != request.auth.uid
        && request.resource.data.status == 'ringing';
      // Cualquiera de los dos actualiza (aceptar, mandar la respuesta, avanzar la ronda, colgar).
      allow update: if signedIn() && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid)
        && request.resource.data.callerId == resource.data.callerId && request.resource.data.calleeId == resource.data.calleeId;
      allow delete: if signedIn() && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid);

      match /callerCandidates/{cid} {
        allow read: if signedIn() && (get(/databases/$(database)/documents/battle_calls/$(id)).data.callerId == request.auth.uid || get(/databases/$(database)/documents/battle_calls/$(id)).data.calleeId == request.auth.uid);
        allow create: if signedIn() && get(/databases/$(database)/documents/battle_calls/$(id)).data.callerId == request.auth.uid;
        allow update, delete: if false;
      }
      match /calleeCandidates/{cid} {
        allow read: if signedIn() && (get(/databases/$(database)/documents/battle_calls/$(id)).data.callerId == request.auth.uid || get(/databases/$(database)/documents/battle_calls/$(id)).data.calleeId == request.auth.uid);
        allow create: if signedIn() && get(/databases/$(database)/documents/battle_calls/$(id)).data.calleeId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ── "Ir en vivo" libre (cualquier usuario, distinto de las cátedras oficiales en `lives`):
    //    { uid, displayName, startedAt }. El id del documento es el uid: una sesión en vivo por persona. ──
    match /live_sessions/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ── Progreso del Plan de Estudio de Waacking (solo el dueño lo ve y lo edita):
    //    { completedModules: [...], quizScores: {...}, checklist: {...}, reflections: {...}, updatedAt } ──
    match /study_progress/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ── Grupos: el id del grupo es el código de invitación (no adivinable). Solo los miembros ven el grupo y su chat.
    //    { name, description, ownerId, memberIds[], createdAt } ──
    match /groups/{gid} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.get('name', '').size() >= 1 && shortText('name', 60) && shortText('description', 280)
        && request.resource.data.get('kind', 'grupo') in ['grupo', 'clase']
        && (request.resource.data.get('kind', 'grupo') == 'grupo' || isStaff())
        && request.resource.data.keys().hasOnly(['name', 'description', 'kind', 'ownerId', 'memberIds', 'createdAt']);
      allow update: if signedIn() && (
          // unirse: agregarse a sí mismo (y nada más), máx. 50 miembros
          (!(request.auth.uid in resource.data.memberIds) && only(['memberIds'])
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
            && request.resource.data.memberIds.size() <= 50
            && request.resource.data.memberIds.hasAll(resource.data.memberIds)
            && request.auth.uid in request.resource.data.memberIds)
          // salirse (el dueño no puede)
          || (request.auth.uid in resource.data.memberIds && request.auth.uid != resource.data.ownerId && only(['memberIds'])
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
            && resource.data.memberIds.hasAll(request.resource.data.memberIds)
            && !(request.auth.uid in request.resource.data.memberIds))
          // el dueño edita nombre y descripción
          || (resource.data.ownerId == request.auth.uid && only(['name', 'description'])
            && request.resource.data.get('name', '').size() >= 1 && shortText('name', 60) && shortText('description', 280))
        );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /messages/{mid} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.memberIds;
        allow create: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.memberIds
          && request.resource.data.uid == request.auth.uid && shortText('text', 2000)
          && request.resource.data.get('kind', 'msg') in ['msg', 'resumen']
          && (request.resource.data.get('kind', 'msg') == 'msg' || get(/databases/$(database)/documents/groups/$(gid)).data.ownerId == request.auth.uid)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'kind', 'mediaUrl', 'mediaType', 'createdAt']);
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid
          || get(/databases/$(database)/documents/groups/$(gid)).data.ownerId == request.auth.uid);
      }
    }

    // ── Comunidad (público para usuarios con sesión): cada quien solo publica y edita lo suyo ──
    match /community_messages/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.get('uid', '') == request.auth.uid && shortText('text', 2000);
      allow update: if signedIn() && resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.uid == resource.data.uid && shortText('text', 2000);
      allow delete: if isAdmin() || (signedIn() && resource.data.get('uid', '') == request.auth.uid);
    }
    match /chat_messages/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.get('uid', '') == request.auth.uid && shortText('text', 2000);
      allow update: if signedIn() && resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.uid == resource.data.uid && shortText('text', 2000);
      allow delete: if isAdmin() || (signedIn() && resource.data.get('uid', '') == request.auth.uid);
    }

    // ── Mensajes directos: { participants: [uidA, uidB], senderId, text, createdAt } ──
    // Solo los dos participantes los leen. Se consultan con where('participants', 'array-contains', uid).
    match /direct_messages/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && shortText('text', 2000);
      allow update: if false; // los mensajes no se editan
      allow delete: if signedIn() && resource.data.senderId == request.auth.uid;
    }

    // ── Amistades: { users: [uidA, uidB], requesterId, status: pending|accepted|declined|blocked } ──
    match /friendships/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.users.size() == 2
        && request.auth.uid in request.resource.data.users
        && request.resource.data.status == 'pending';
      // Solo se cambia el estado y quien envió la solicitud no puede aceptarla por la otra persona.
      allow update: if signedIn() && request.auth.uid in resource.data.users
        && only(['status'])
        && request.resource.data.status in ['accepted', 'declined', 'blocked']
        && (request.resource.data.status != 'accepted' || resource.data.requesterId != request.auth.uid);
      allow delete: if signedIn() && request.auth.uid in resource.data.users;
    }

    // ── Interacción real en Reels/contenido: like y comentarios por documento, y seguir a alguien ──
    match /{content}/{docId}/likes/{uid} {
      allow read: if signedIn();
      allow create, delete: if signedIn() && content in ['reels', 'lives'] && request.auth.uid == uid;
      allow update: if false;
    }
    match /{content}/{docId}/comments/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && content in ['reels', 'lives', 'posts']
        && request.resource.data.get('uid', '') == request.auth.uid && shortText('text', 500);
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && resource.data.get('uid', '') == request.auth.uid);
    }
    // { followerId, followingId }, id del documento = "<followerId>_<followingId>" (evita duplicados).
    match /follows/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId != request.auth.uid
        && id == request.resource.data.followerId + '_' + request.resource.data.followingId;
      allow delete: if signedIn() && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }

    // ── Publicaciones del dashboard: { authorId, authorName, authorHandle, authorPhotoURL, text,
    //    mediaUrl, mediaType, likesCount, commentsCount, createdAt }. Cualquiera con sesión las lee
    //    (el feed de cada quien filtra por autor del lado del cliente: sus amigos y él mismo);
    //    solo el autor publica/edita/borra lo suyo.
    match /posts/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid
        && shortText('text', 2000)
        && request.resource.data.get('mediaType', null) in [null, 'image', 'video']
        && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'authorHandle', 'authorPhotoURL', 'text', 'mediaUrl', 'mediaType', 'likesCount', 'commentsCount', 'createdAt']);
      allow update: if signedIn() && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId && only(['text']) && shortText('text', 2000);
      allow delete: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);

      // Un "me gusta" por persona: el id del documento es el uid, así no se puede duplicar.
      match /likes/{uid} {
        allow read: if signedIn();
        allow create, delete: if signedIn() && request.auth.uid == uid;
        allow update: if false;
      }
    }

    // ── Batallas: { hostId, participants: [uid…], status, … } ──
    match /battles/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.hostId == request.auth.uid && request.auth.uid in request.resource.data.participants;
      allow update: if signedIn() && request.auth.uid in resource.data.participants && request.resource.data.hostId == resource.data.hostId;
      allow delete: if isAdmin() || (signedIn() && resource.data.hostId == request.auth.uid);
    }

    // ── Notificaciones: { userId, … }. Las crea el servidor; el dueño solo las lee, marca como leídas o borra ──
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if false;
      allow update: if signedIn() && resource.data.userId == request.auth.uid && only(['read']);
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // ── Datos personales con { userId }: playlists, comentarios de práctica y registros ──
    match /user_playlists/{id} { allow read, update, delete: if signedIn() && resource.data.userId == request.auth.uid; allow create: if signedIn() && request.resource.data.userId == request.auth.uid; }
    match /feedback_items/{id} { allow read, update, delete: if signedIn() && resource.data.userId == request.auth.uid; allow create: if signedIn() && request.resource.data.userId == request.auth.uid; }
    match /practice_logs/{id}  { allow read, update, delete: if signedIn() && resource.data.userId == request.auth.uid; allow create: if signedIn() && request.resource.data.userId == request.auth.uid; }

    // ── Comprobación de conexión: solo lectura ──
    match /test/{docId} { allow read: if true; allow write: if false; }
  }
}
