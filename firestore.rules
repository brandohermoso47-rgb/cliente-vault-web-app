rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'usuario');
    }
    function isAdmin() { return signedIn() && role() == 'admin'; }
    // Personal que publica contenido: admin o instructor.
    function isStaff() { return signedIn() && (role() == 'admin' || role() == 'instructor'); }
    function roleUnchanged() {
      return request.resource.data.get('role', 'usuario') == resource.data.get('role', 'usuario');
    }

    // ── Perfiles ─────────────────────────────────────────────────────────
    match /users/{userId} {
      // Los perfiles solo los ven usuarios con sesión (guardan correo).
      allow read: if signedIn();
      // Al crearse, todo perfil nace como 'usuario': nadie se auto-asigna admin/instructor.
      allow create: if isOwner(userId) && request.resource.data.get('role', 'usuario') == 'usuario';
      // El dueño edita su perfil pero no su rol; solo un admin cambia roles.
      allow update: if (isOwner(userId) && roleUnchanged()) || isAdmin();
      allow delete: if isAdmin();

      // Datos privados del usuario (playlists, favoritos, práctica, etc.)
      match /{sub}/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ── Contenido de la plataforma: lo lee cualquiera con sesión, lo publica el personal ──
    match /{content}/{docId} {
      allow read: if signedIn()
        && content in ['reels', 'teachers', 'lives', 'lessons', 'announcements', 'presentations',
                       'instructor_playlists', 'instructor_tracks', 'instructor_drive_tracks'];
      allow write: if isStaff()
        && content in ['reels', 'teachers', 'lives', 'lessons', 'announcements', 'presentations',
                       'instructor_playlists', 'instructor_tracks', 'instructor_drive_tracks'];
    }

    // ── Comunidad y mensajes: usuarios con sesión; cada quien solo edita lo suyo ──
    match /community_messages/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.get('uid', request.auth.uid) == request.auth.uid;
      allow update, delete: if isAdmin() || (signedIn() && resource.data.get('uid', '') == request.auth.uid);
    }
    match /chat_messages/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.get('uid', request.auth.uid) == request.auth.uid;
      allow update, delete: if isAdmin() || (signedIn() && resource.data.get('uid', '') == request.auth.uid);
    }
    match /direct_messages/{id}  { allow read, write: if signedIn(); }
    match /friendships/{id}      { allow read, write: if signedIn(); }
    match /battles/{id}          { allow read, write: if signedIn(); }
    match /user_playlists/{id}   { allow read, write: if signedIn(); }
    match /feedback_items/{id}   { allow read, write: if signedIn(); }
    match /notifications/{id}    { allow read, write: if signedIn(); }
    match /practice_logs/{id}    { allow read, write: if signedIn(); }

    // ── Comprobación de conexión: solo lectura (antes era escritura pública) ──
    match /test/{docId} { allow read: if true; allow write: if false; }
  }
}
