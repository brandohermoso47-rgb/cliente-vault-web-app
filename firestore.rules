rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'usuario');
    }
    function isAdmin() { return signedIn() && role() == 'admin'; }
    // Personal que publica contenido: admin, instructor o estudio (roles que asigna un admin).
    function isStaff() { return signedIn() && (role() == 'admin' || role() == 'instructor' || role() == 'estudio'); }
    function roleUnchanged() {
      return request.resource.data.get('role', 'usuario') == resource.data.get('role', 'usuario');
    }

    // ── Perfiles ─────────────────────────────────────────────────────────
    match /users/{userId} {
      // Los perfiles (nombre, usuario, país, bio, foto, rol) los ven usuarios con sesión. El correo NO se guarda aquí.
      allow read: if signedIn();
      // Al crearse, todo perfil nace como 'usuario': nadie se auto-asigna admin/instructor.
      allow create: if isOwner(userId) && request.resource.data.get('role', 'usuario') == 'usuario';
      // El dueño edita su perfil pero no su rol; solo un admin cambia roles.
      allow update: if (isOwner(userId) && roleUnchanged()) || isAdmin();
      allow delete: if isAdmin();

      // Datos privados del usuario (playlists, favoritos, práctica, etc.)
      match /{sub}/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ── Solicitudes de instructor/estudio: las crea el dueño (siempre 'pendiente'); solo un admin las resuelve ──
    match /applications/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.status == 'pendiente'
        && request.resource.data.kind in ['instructor', 'estudio']
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── Contenido de la plataforma: lo lee cualquiera con sesión ──
    match /{content}/{docId} {
      allow read: if signedIn()
        && content in ['reels', 'teachers', 'lives', 'lessons', 'announcements', 'presentations',
                       'instructor_playlists', 'instructor_tracks', 'instructor_drive_tracks'];
      // Publica el personal, pero solo edita/borra lo suyo (ownerId); el admin edita todo.
      allow create: if content in ['reels', 'teachers', 'lives', 'lessons', 'announcements', 'presentations',
                                   'instructor_playlists', 'instructor_tracks', 'instructor_drive_tracks']
        && (isAdmin() || (isStaff() && request.resource.data.get('ownerId', '') == request.auth.uid));
      allow update, delete: if content in ['reels', 'teachers', 'lives', 'lessons', 'announcements', 'presentations',
                                          'instructor_playlists', 'instructor_tracks', 'instructor_drive_tracks']
        && (isAdmin() || (isStaff() && resource.data.get('ownerId', '') == request.auth.uid));
    }

    // ── Pagos: SOLO el servidor (Cloud Functions con Admin SDK) escribe estas colecciones ──
    match /plans/{planId} {
      allow read: if signedIn();     // catálogo de planes (los IDs de precio de Stripe no son secretos)
      allow write: if isAdmin();
    }
    match /subscriptions/{subId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /payoutAccounts/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }
    match /customers/{uid} { allow read, write: if false; }

    // ── Comunidad y mensajes: usuarios con sesión; cada quien solo edita lo suyo ──
    match /community_messages/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.get('uid', request.auth.uid) == request.auth.uid;
      allow update, delete: if isAdmin() || (signedIn() && resource.data.get('uid', '') == request.auth.uid);
    }
    match /chat_messages/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.get('uid', request.auth.uid) == request.auth.uid;
      allow update, delete: if isAdmin() || (signedIn() && resource.data.get('uid', '') == request.auth.uid);
    }
    match /direct_messages/{id}  { allow read, write: if signedIn(); }
    match /friendships/{id}      { allow read, write: if signedIn(); }
    match /battles/{id}          { allow read, write: if signedIn(); }
    match /user_playlists/{id}   { allow read, write: if signedIn(); }
    match /feedback_items/{id}   { allow read, write: if signedIn(); }
    match /notifications/{id}    { allow read, write: if signedIn(); }
    match /practice_logs/{id}    { allow read, write: if signedIn(); }

    // ── Comprobación de conexión: solo lectura (antes era escritura pública) ──
    match /test/{docId} { allow read: if true; allow write: if false; }
  }
}
